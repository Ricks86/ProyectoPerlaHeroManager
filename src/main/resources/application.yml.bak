server:
  port: 8080

spring:
  application:
    name: proyectorol
  datasource:
    # Por defecto usa H2 en memoria para pruebas locales inmediatas. 
    # Para Oracle Autonomous DB, reemplazar url/username/password con TNS/wallet string de Oracle.
    url: jdbc:h2:mem:proyectoroldb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
    driver-class-name: org.h2.Driver
    username: sa
    password: 
    # Configuración para Oracle ADB:
    # url: jdbc:oracle:thin:@tu_instancia_adb_high?TNS_ADMIN=/path/to/wallet
    # driver-class-name: oracle.jdbc.OracleDriver
    # username: ADMIN
    # password: TuPasswordOracle123!
  h2:
    console:
      enabled: true
      path: /h2-console
  jpa:
    database-platform: org.hibernate.dialect.H2Dialect
    # Para Oracle ADB: org.hibernate.dialect.OracleDialect
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

logging:
  level:
    com.proyectorol: DEBUG
